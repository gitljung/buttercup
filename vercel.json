{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/baglbox",
      "destination": "/bagl/",
      "permanent": true
    },
    {
      "source": "/baglbox/",
      "destination": "/bagl/",
      "permanent": true
    },
    {
      "source": "/baglbox/:path*",
      "destination": "/bagl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/traning/halsoresa/",
      "destination": "/traning/index.html"
    }
  ]
}